{
  "name": "ichnaea-android",
  "version": "0.3.4",
  "description": "Ichnaea Android port — P2P privacy-first location check-ins with E2E encryption",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npx cap sync && npx cap open android",
    "test": "brittle test/*.test.js",
    "build:node": "esbuild src/node/server.js --bundle --platform=node --target=es2022 --format=cjs --alias:events=bare-events --alias:fs=bare-fs --alias:path=bare-path --alias:url=bare-url --external:udx-native --external:sodium-native --external:bare-fs --external:bare-path --external:bare-url --external:bare-dns --external:bare-crypto --external:bare-tcp --external:bare-tls --outfile=android/app/src/main/assets/bare-bundle/bundle.cjs",
    "build:bare": "node scripts/bare-assets.mjs",
    "build:apk": "npm run build:node && npm run build:bare && npx cap sync android && node scripts/plugins.mjs && cd android && ./gradlew assembleDebug",
    "build:renderer": "node -e \"const fs=require('fs');const p='src/index.html';let s=fs.readFileSync(p,'utf8');s=s.replace(/main\\.bundle\\.js\\?v=\\d+/, 'main.bundle.js?v='+Date.now());fs.writeFileSync(p,s)\" && esbuild src/main.js --bundle --format=esm --target=es2019 --outfile=src/main.bundle.js",
    "build:assets": "node scripts/bare-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "b4a": "^1.8.1",
    "bare-ws": "^3.0.0",
    "compact-encoding": "^3.3.0",
    "d3-geo-polygon": "^1.12.1",
    "globe.gl": "^2.46.1",
    "hypercore": "^10.38.2",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "random-access-memory": "^6.2.1",
    "sodium-javascript": "^0.8.0",
    "sodium-universal": "^5.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "brittle": "^3.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
